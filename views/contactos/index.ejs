<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Contactos</title>
  <!-- CSS de Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Iconos de Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

  <div class="container my-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
        <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Lista de Contactos</h4>

        <!-- Botones condicionales según el estado de la sesión -->
        <div class="d-flex align-items-center gap-2">
          <% if (user) { %>
            <a href="/contactos/crear" class="btn btn-success btn-sm font-weight-bold">
              <i class="bi bi-person-plus-fill me-1"></i> Nuevo Contacto
            </a>
            <a href="/logout" class="btn btn-light text-danger btn-sm font-weight-bold shadow-sm">
              <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
            </a>
            <% } else { %>
              <a href="/login" class="btn btn-light text-primary btn-sm font-weight-bold shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
              </a>
              <% } %>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="text-center" style="width: 80px;">ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Provincia / País</th>
                <th class="text-end pe-4" style="width: 150px;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (contactos.length===0) { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">
                    <em>No hay contactos registrados en el sistema.</em>
                  </td>
                </tr>
                <% } else { %>
                  <% contactos.forEach(c=> { %>
                    <tr>
                      <td class="text-center fw-bold text-secondary">#<%= c.id %>
                      </td>
                      <td class="fw-semibold text-dark">
                        <%= c.nombre %>
                      </td>
                      <td>
                        <% if (c.telefono) { %>
                          <a href="tel:<%= c.telefono %>" class="text-decoration-none text-dark">
                            <i class="bi bi-telephone me-1 text-muted"></i>
                            <%= c.telefono %>
                          </a>
                          <% } else { %>
                            <span class="text-muted fs-7">-</span>
                            <% } %>
                      </td>
                      <td>
                        <% if (c.email) { %>
                          <a href="mailto:<%= c.email %>" class="text-decoration-none">
                            <i class="bi bi-envelope me-1 text-muted"></i>
                            <%= c.email %>
                          </a>
                          <% } else { %>
                            <span class="text-muted fs-7">-</span>
                            <% } %>
                      </td>
                      <td>
                        <% if (c.provincia) { %>
                          <span class="badge bg-info text-dark bg-opacity-25 border border-info px-2 py-1 me-1">
                            <%= c.provincia.nombre %>
                          </span>
                          <% if (c.provincia.pais) { %>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">
                              <i class="bi bi-globe me-1"></i>
                              <%= c.provincia.pais.nombre %>
                            </span>
                            <% } %>
                              <% } else { %>
                                <span class="text-muted fs-7">Sin provincia</span>
                                <% } %>
                      </td>
                      <td class="text-end pe-4">
                        <% if (user) { %>
                          <!-- Usuario autenticado: Botón de Editar -->
                          <a href="/contactos/<%= c.id %>/editar" class="btn btn-outline-primary btn-sm me-1"
                            title="Editar">
                            <i class="bi bi-pencil-square"></i>
                          </a>
                          <% } else { %>
                            <!-- Usuario NO autenticado: Botón "Solo lectura" que envía a la ruta protegida -->
                            <a href="/contactos/<%= c.id %>/editar" class="btn btn-outline-secondary btn-sm"
                              title="Solo lectura">
                              <i class="bi bi-eye me-1"></i> Solo lectura
                            </a>
                            <% } %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</body>

</html>