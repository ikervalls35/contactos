<form action="/contactos" method="POST">
    <div>
        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre" value="<%= contacto.nombre || '' %>" required>
    </div>

    <div>
        <label for="telefono">Teléfono:</label>
        <input type="text" id="telefono" name="telefono" value="<%= contacto.telefono || '' %>" required>
    </div>

    <div>
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= contacto.email || '' %>" required>
    </div>

    <div>
        <label for="provinciaId">Provincia:</label>
        <select name="provinciaId" id="provinciaId" required>
            <option value="">-- Selecciona una provincia --</option>
            <% provincias.forEach(provincia=> { %>
                <option value="<%= provincia.id %>" <%=contacto.provinciaId==provincia.id ? 'selected' : '' %>>
                    <%= provincia.nombre %>
                </option>
                <% }); %>
        </select>
    </div>

    <button type="submit">Crear Contacto</button>
</form>